# Lets the airplaymatrix-webui service run exactly one script as root, with
# no password prompt. That script (airplaymatrix-privileged.py) re-validates
# every argument itself -- see its docstring. Install with:
#   visudo -cf this-file   # validate syntax first
#   install -o root -g root -m 0440 this-file /etc/sudoers.d/airplaymatrix-webui
airplaymatrix ALL=(root) NOPASSWD: /usr/local/bin/airplaymatrix-privileged.py *
