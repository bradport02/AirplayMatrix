[Unit]
Description=AirplayMatrix headless LED matrix bridge (shairport-sync metadata -> ESP32/HUB75)
Documentation=file:///home/airplaymatrix/Documents/AirplayMatrix-main/Software/matrix/matrix_daemon.py
After=shairport-sync.service
Wants=shairport-sync.service

[Service]
Type=simple
WorkingDirectory=/home/airplaymatrix/Documents/AirplayMatrix-main/Software
ExecStart=/usr/bin/python3 -m matrix.matrix_daemon
# Needs to read shairport-sync's metadata FIFO and open the ESP32's serial
# port. Running as the shairport-sync user keeps FIFO access simple (same
# user already owns/writes it); add that user to "dialout" for serial
# access -- see docs/install-pi-zero-wh.md.
User=shairport-sync
Group=shairport-sync
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
